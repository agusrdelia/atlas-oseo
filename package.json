  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/three": "0.185.4",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.9.6"
  }
}
